# =====================================================================
# OpenFilingRAG environment configuration
# Copy to `.env` and fill in your own keys.
# =====================================================================
# Data-source tiers:
#   Tier 0  manual files dropped into data/sample_filings/  (always on)
#   Tier 1  SEC EDGAR  — free, no key, default fetcher       (always on)
#   Tier 2  Alpha Vantage OR Massive  — optional enrichment  (pick one)
# =====================================================================

# --- Database (Supabase) --------------------------------------------
# Supabase Session Pooler URI. In your Supabase dashboard:
#   Settings → Database → Connection string → "Session pooler"
# Must use port 5432. The Transaction Pooler on 6543 disables prepared
# statements and breaks SQLAlchemy.
#
# Replace `postgresql://` with `postgresql+psycopg://` (SQLAlchemy needs
# the driver suffix). sslmode=require is auto-added by app/db/session.py
# if you omit it.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PGVECTOR_DIM=1536

# --- LLM provider ---------------------------------------------------
# Leave LLM_PROVIDER blank to auto-pick: openai if key present, else
# anthropic, else mock. Override with: openai | anthropic | mock
LLM_PROVIDER=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Without an LLM key the system runs in MOCK MODE — useful for tests
# and demos. For real research, set OPENAI_API_KEY (recommended).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =====================================================================
# TIER 1 — SEC EDGAR (free, default, no API key required)
# =====================================================================
# SEC requires a User-Agent that identifies the requester. Replace the
# placeholder with your real name + email — otherwise SEC may throttle
# or reject your requests.
#   Format:  "Your Name your.email@example.com"
#   Policy:  https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT=OpenFilingRAG/0.1 you@example.com

# Where to cache SEC's company-tickers map and downloaded filings.
SEC_EDGAR_CACHE_DIR=data/edgar_cache
SEC_EDGAR_FILINGS_DIR=data/sample_filings

# =====================================================================
# TIER 2 — optional enrichment providers (pick AT MOST ONE)
# Both are free-tier-friendly. They give you earnings call transcripts,
# company news, and structured fundamentals. EDGAR alone does not
# provide these. Configure ONE — you don't need both.
# =====================================================================

# Option A: Alpha Vantage  https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Option B: Massive        https://massive.com
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# --- Service ---------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Frontend (Next.js) ---------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
